listen              1935;
max_connections     1000;
daemon              off;
srs_log_tank        console;

http_api {
    enabled         on;
    listen          1985;
}

http_server {
    enabled         on;
    listen          8080;
    dir             ./objs/nginx/html;
}

rtc_server {
    enabled         on;
    listen          8000;
    candidate       39.97.55.150;
}

vhost __defaultVhost__ {
    min_latency     on;
    tcp_nodelay     on;

    rtc {
        enabled     on;
        rtmp_to_rtc on;
        pli_for_rtmp on;
    }

    play {
        gop_cache   off;
        queue_length 10;
        mw_latency  100;
    }

    publish {
        mr          off;
        # 2026-09-26 推流静默容忍 5s(默认)→30s：与 cf 侧一致，
        # 避免推流端偶发长停顿被强杀导致断流循环
        normal_timeout    30000;
    }

    http_hooks {
        enabled         on;
        on_publish      https://api.rrrosmontis.icu/v1/live/publish/on_publish;
        on_unpublish    https://api.rrrosmontis.icu/v1/live/publish/on_unpublish;
    }

    http_remux {
        enabled     on;
        mount       [vhost]/[app]/[stream].flv;
    }

    hls {
        enabled         on;
        hls_path        ./objs/nginx/html;
        hls_fragment    1;
        hls_window      3;
        hls_cleanup     on;
        hls_m3u8_file   [app]/[stream].m3u8;
        hls_ts_file     [app]/[stream]-[seq].ts;
    }
}

